  "query": "\n        SELECT \n            group_address,\n            member_address, \n            member_percentage::text as \"member_percentage!\", \n            is_active, \n            added_at::text as \"added_at!\"\n        FROM group_members \n        WHERE is_active = true\n        ORDER BY group_address, member_percentage DESC\n        ",
