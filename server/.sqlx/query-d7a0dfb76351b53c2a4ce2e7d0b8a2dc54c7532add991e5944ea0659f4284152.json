{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            w.created_at::text as \"payout_at!\",\n            w.withdrawn_by as \"recipient!\",\n            w.token_address,\n            w.amount::text as \"amount!\",\n            w.transaction_hash,\n            cf.pool_address,\n            cf.name as \"pool_name!\"\n        FROM withdrawals w\n        JOIN crowd_funding cf ON w.crowd_funding_id = cf.id\n        ORDER BY w.created_at DESC\n        ",
